    "/api/koi/query": {
      "post": {
        "tags": ["Knowledge - Search"],
        "summary": "Semantic knowledge search",
        "description": "Search the Regen Network knowledge base using hybrid semantic search. Returns relevant documents about regenerative agriculture, Regen Network, ecological credits, and related topics. Results include confidence scores and source citations.",
        "operationId": "koi_semantic_search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["question"],
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "Natural language question or search query"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 10,
                    "description": "Maximum number of results to return"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Search results with confidence scores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "question": {"type": "string"},
                    "total_results": {"type": "integer"},
                    "confidence": {"type": "number"},
                    "execution_time": {"type": "number"},
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {"type": "string"},
                          "content": {"type": "string"},
                          "score": {"type": "number"},
                          "source": {"type": "string"},
                          "rid": {"type": "string"},
                          "metadata": {"type": "object"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/koi/graph": {
      "post": {
        "tags": ["Knowledge - Graph"],
        "summary": "Query the code knowledge graph",
        "description": "Query the code knowledge graph for entities (Classes, Functions, Handlers, Keepers, etc.) and their relationships. Supports listing repositories, searching entities, finding module relationships, and traversing call hierarchies.",
        "operationId": "koi_graph_query",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query_type"],
                "properties": {
                  "query_type": {
                    "type": "string",
                    "enum": ["list_repos", "list_entity_types", "get_entity_stats", "find_by_type", "search_entities", "related_entities", "list_modules", "get_module", "keeper_for_msg", "msgs_for_keeper", "find_callers", "find_callees"],
                    "description": "Type of graph query to perform"
                  },
                  "entity_name": {
                    "type": "string",
                    "description": "Entity name or search term (for search_entities, related_entities)"
                  },
                  "entity_type": {
                    "type": "string",
                    "description": "Entity type filter (for find_by_type). Examples: Sensor, Handler, Class, Interface, Function, Keeper"
                  },
                  "repo_name": {
                    "type": "string",
                    "description": "Repository name filter (e.g., koi-sensors, regen-ledger)"
                  },
                  "module_name": {
                    "type": "string",
                    "description": "Module name (for get_module, keeper_for_msg, msgs_for_keeper)"
                  }
                }
              },
              "examples": {
                "list_repos": {"value": {"query_type": "list_repos"}},
                "list_entity_types": {"value": {"query_type": "list_entity_types"}},
                "search_entities": {"value": {"query_type": "search_entities", "entity_name": "ecocredit"}}
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Graph query results",
