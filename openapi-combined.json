        "description": "Get a complete summary of all API capabilities. CALL THIS FIRST to understand what information is available. Returns organized list of all endpoints grouped by function, helping you choose the right endpoint for any question.",
        "operationId": "get_api_summary",
        "responses": {
          "200": {
            "description": "API capabilities organized by category",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "description": {"type": "string"},
                    "capabilities": {
                      "type": "object",
                      "description": "Available API capabilities grouped by category"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
